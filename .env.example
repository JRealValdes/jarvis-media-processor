# Jarvis Media Processor configuration (copy to .env and adjust).
# All keys use the JMP_ prefix. Do not commit real secrets.

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
JMP_LOG_LEVEL=INFO

# Workspace for temporary files and future job artifacts (relative or absolute)
JMP_WORK_DIR=.jmp

# FFmpeg / FFprobe executables (names on PATH, or absolute paths)
JMP_FFMPEG_PATH=ffmpeg
JMP_FFPROBE_PATH=ffprobe

# Audio analysis / acoustic landmarks
JMP_AUDIO_ANALYSIS_SAMPLE_RATE=16000
JMP_AUDIO_ANALYSIS_CHANNELS=1
JMP_AUDIO_LANDMARK_HOP_SECONDS=0.01
JMP_AUDIO_LANDMARK_FRAME_SECONDS=0.04
JMP_AUDIO_LANDMARK_MIN_DISTANCE_SECONDS=0.25
JMP_AUDIO_LANDMARK_PROMINENCE=0.15
JMP_AUDIO_LANDMARK_MAX_COUNT=200

# Video sampling / visual matching
JMP_VIDEO_SAMPLE_FPS=1.0
JMP_VIDEO_PHASH_SIZE=8
JMP_VIDEO_NORMALIZE_SIZE=256
JMP_VIDEO_CROP_LETTERBOX=true
JMP_VIDEO_MATCH_MAX_DISTANCE=12
JMP_VIDEO_MATCH_MAX_PER_BASE=3
