# Jarvis Media Processor configuration (copy to .env and adjust).
# All keys use the JMP_ prefix. Do not commit real secrets.

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
JMP_LOG_LEVEL=INFO

# Workspace for temporary files and job artifacts (relative or absolute)
JMP_WORK_DIR=.jmp

# After successful jobs, delete bulky intermediate WAV/PNG under the job workspace
JMP_JOBS_CLEANUP_WORKSPACE_ON_SUCCESS=false

# Batch folder defaults (optional; CLI paths override). See docs/batch-workflows.md
# JMP_BATCH_INPUT_DIR=incoming
# JMP_BATCH_OUTPUT_DIR=outgoing
# JMP_BATCH_TEMP_DIR=

# FFmpeg / FFprobe executables (names on PATH, or absolute paths)
JMP_FFMPEG_PATH=ffmpeg
JMP_FFPROBE_PATH=ffprobe

# Audio analysis / acoustic landmarks
JMP_AUDIO_ANALYSIS_SAMPLE_RATE=16000
JMP_AUDIO_ANALYSIS_CHANNELS=1
JMP_AUDIO_LANDMARK_HOP_SECONDS=0.01
JMP_AUDIO_LANDMARK_FRAME_SECONDS=0.04
JMP_AUDIO_LANDMARK_MIN_DISTANCE_SECONDS=0.25
JMP_AUDIO_LANDMARK_PROMINENCE=0.15
JMP_AUDIO_LANDMARK_MAX_COUNT=200

# Video sampling / visual matching
JMP_VIDEO_SAMPLE_FPS=1.0
JMP_VIDEO_PHASH_SIZE=8
JMP_VIDEO_NORMALIZE_SIZE=256
JMP_VIDEO_CROP_LETTERBOX=true
JMP_VIDEO_MATCH_MAX_DISTANCE=12
JMP_VIDEO_MATCH_MAX_PER_BASE=3

# Alignment (content-agnostic defaults; override per deployment if needed)
JMP_ALIGNMENT_INLIER_TOLERANCE_SECONDS=0.12
JMP_ALIGNMENT_VISUAL_INLIER_TOLERANCE_SECONDS=1.5
JMP_ALIGNMENT_VISUAL_MIN_PAIRS=8
JMP_ALIGNMENT_VISUAL_MIN_INLIER_RATIO=0.55
JMP_ALIGNMENT_SPEED_MIN=0.85
JMP_ALIGNMENT_SPEED_MAX=1.2
JMP_ALIGNMENT_AUDIO_DOWNWEIGHT=0.2
JMP_ALIGNMENT_AUDIO_REFINE_WINDOW_SECONDS=2.0
JMP_ALIGNMENT_AUDIO_REFINE_MIN_SCORE=0.05
JMP_ALIGNMENT_UNRELATED_WINDOW_SECONDS=12.0
JMP_ALIGNMENT_UNRELATED_HOP_SECONDS=2.0
JMP_ALIGNMENT_UNRELATED_MIN_SCORE=0.3
JMP_ALIGNMENT_UNRELATED_MIN_SPAN_SECONDS=8.0
JMP_ALIGNMENT_UNRELATED_MAX_SURPLUS_SECONDS=1200.0
JMP_ALIGNMENT_CURVE_CONFIRM_SECONDS=6.0
JMP_ALIGNMENT_MISSING_BASE_FILL_SECONDS=3.0
JMP_VIDEO_SHOT_MIN_DISTANCE=20
